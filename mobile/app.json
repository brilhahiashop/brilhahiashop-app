{
  "expo": {
    "name": "BRILHAH AI Manager",
    "slug": "brilhah-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#07101d"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brilhah.ia"
    },
    "android": {
      "package": "com.brilhah.ia",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#07101d"
      }
    },
    "web": {
      "favicon": "./assets/logo.png"
    }
  }
}
